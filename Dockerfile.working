FROM rust:1.88-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Copy minimal dependencies
COPY Cargo.minimal.toml Cargo.toml
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Copy working source
COPY src/main_working.rs src/main.rs

# Build the working application
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/kusanagi /usr/local/bin/kusanagi
RUN chmod +x /usr/local/bin/kusanagi

EXPOSE 8080
CMD ["/usr/local/bin/kusanagi"]
