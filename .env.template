# Kusanagi v0.9.0 - Environment Configuration Template
# Copy this file and fill in your actual values

# Proxmox Configuration
PROXMOX_URL=https://proxmox.example.com:8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=kusanagi
PROXMOX_TOKEN_SECRET=your-proxmox-token-secret-here

# Home Assistant Configuration
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-home-assistant-long-lived-token-here

# Metrics & Telemetry
PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.kube-prometheus-stack.svc:9090
OPENOBSERVE_ENDPOINT=https://openobserve.example.com/api/default/v1/logs
OPENOBSERVE_AUTH=your-base64-auth-token-here
APM_SAMPLE_RATE=1.0

# Instructions:
# 1. Create Proxmox API token:
#    - Login to Proxmox web UI
#    - Go to Datacenter > Permissions > API Tokens
#    - Create new token for user 'root@pam'
#    - Copy the token ID and secret
#
# 2. Create Home Assistant long-lived token:
#    - Login to Home Assistant
#    - Go to Profile > Security > Long-Lived Access Tokens
#    - Create new token
#    - Copy the token value
#
# 3. Create Kubernetes Secret:
#    kubectl create secret generic kusanagi-config \
#      --from-literal=proxmox-url="$PROXMOX_URL" \
#      --from-literal=proxmox-user="$PROXMOX_USER" \
#      --from-literal=proxmox-token-id="$PROXMOX_TOKEN_ID" \
#      --from-literal=proxmox-token-secret="$PROXMOX_TOKEN_SECRET" \
#      --from-literal=ha-url="$HOME_ASSISTANT_URL" \
#      --from-literal=ha-token="$HOME_ASSISTANT_TOKEN" \
#      --from-literal=prometheus-url="$PROMETHEUS_URL" \
#      --from-literal=openobserve-endpoint="$OPENOBSERVE_ENDPOINT" \
#      --from-literal=openobserve-auth="$OPENOBSERVE_AUTH" \
#      -n kusanagi
