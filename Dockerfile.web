# Dockerfile pour Kusanagi - Version Web Simple
FROM rust:1.88-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Create a minimal Cargo.toml
RUN echo '[package]' > Cargo.toml && \
    echo 'name = "kusanagi-web"' >> Cargo.toml && \
    echo 'version = "1.0.0"' >> Cargo.toml && \
    echo 'edition = "2021"' >> Cargo.toml && \
    echo '' >> Cargo.toml && \
    echo '[dependencies]' >> Cargo.toml && \
    echo 'tokio = { version = "1.0", features = ["full"] }' >> Cargo.toml && \
    echo 'actix-web = "4.0"' >> Cargo.toml && \
    echo 'actix-files = "0.6"' >> Cargo.toml && \
    echo 'serde_json = "1.0"' >> Cargo.toml && \
    echo 'chrono = { version = "0.4", features = ["serde"] }' >> Cargo.toml && \
    echo 'env_logger = "0.10"' >> Cargo.toml

# Create dummy main to cache dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
RUN rm src/main.rs

# Copy source files
COPY src/main.rs ./src/
COPY static ./static

# Build the application
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false -u 1001 kusanagi

# Environment variables
ENV RUST_LOG=info
ENV KUSANAGI_ENV=web

# Copy binary and static files
COPY --from=builder /app/target/release/kusanagi-web /usr/local/bin/kusanagi-web
COPY --from=builder /app/static /app/static

# Set permissions
RUN chown kusanagi:kusanagi /usr/local/bin/kusanagi-web
RUN chmod +x /usr/local/bin/kusanagi-web

# Create app directory and set permissions
RUN mkdir -p /app && chown -R kusanagi:kusanagi /app
WORKDIR /app

# Switch to non-root user
USER kusanagi

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Labels for metadata
LABEL maintainer="Kusanagi Team" \
      version="1.1.0-web" \
      description="Kubernetes monitoring with web interface"

# Run the application
CMD ["/usr/local/bin/kusanagi-web"]
